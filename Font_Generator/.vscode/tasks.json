{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build NDS",
            "type": "shell",
            "command": "bash",
            "options": {
                "cwd": "${workspaceFolder}/nds_font_render"
            },
            "args": [
                "-i",
                "-c",
                "make"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "run",
            "type": "shell",
            "command": "bash",
            "options": {
                "cwd": "${workspaceFolder}/nds_font_render"
            },
            "args": [
                "-i",
                "-c",
                "melonds \"$(basename \"$PWD\").nds\""
            ],
            "dependsOn": "Build NDS",
            "problemMatcher": []
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "bash",
            "options": {
                "cwd": "${workspaceFolder}/nds_font_render"
            },
            "args": [
                "-i",
                "-c",
                "make clean"
            ],
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: arm-none-eabi-gcc build active file",
            "command": "/opt/devkitpro/devkitARM/bin/arm-none-eabi-gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}