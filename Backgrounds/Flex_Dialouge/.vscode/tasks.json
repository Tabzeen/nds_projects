{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build NDS",
            "type": "shell",
            "command": "bash",
            "args": [
                "-i", "-c", "make"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "run",
            "type": "shell",
            "command": "bash",
            "args": [
                "-i", "-c",
                "melonds \"$(basename \"$PWD\").nds\""
            ],
            "dependsOn": "Build NDS",
            "problemMatcher": []
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "bash",
            "args": [
                "-i", "-c", "make clean"
            ],
            "problemMatcher": []
        }
    ]
}